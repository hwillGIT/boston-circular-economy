{
  "name": "boston-circular-economy",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "pnpm --filter client dev & pnpm --filter server dev",
    "lint": "pnpm --filter client lint && pnpm --filter server lint",
    "lint:css": "stylelint 'client/src/**/*.css'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:generate": "typedoc",
    "docs:audit": "typedoc --emit none --logLevel Warn",
    "typecheck": "pnpm --filter client build --noEmit && pnpm --filter server build --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "server/**/*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "client/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0"
  }
}
